<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>zwo-plan-pusher example</author>
  <name>Low-Cadence Force 5x5min</name>
  <description>Muscular endurance: 5 x 5min @ 80% FTP at 55-60rpm. Pairs well with strength training. Skip if knees complain.</description>
  <sportType>bike</sportType>
  <tags><tag name="Strength"/><tag name="Tempo"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.68"><textevent timeoffset="0" message="Easy ramp-up. Settle in, 85-90rpm"/><textevent timeoffset="540" message="Almost done with warmup"/></Warmup>
    <SteadyState Duration="300" Power="0.650"></SteadyState>
    <SteadyState Duration="300" Power="0.800" Cadence="60"><textevent timeoffset="0" message="Force rep 1/5: 80% FTP @ 55-60rpm. Seated, quiet upper body"/><textevent timeoffset="150" message="Drive through the whole stroke"/></SteadyState>
    <SteadyState Duration="180" Power="0.600" Cadence="95"><textevent timeoffset="0" message="Easy spin 95rpm"/></SteadyState>
    <SteadyState Duration="300" Power="0.800" Cadence="60"><textevent timeoffset="0" message="Force rep 2/5: 80% FTP @ 55-60rpm. Seated, quiet upper body"/><textevent timeoffset="150" message="Drive through the whole stroke"/></SteadyState>
    <SteadyState Duration="180" Power="0.600" Cadence="95"><textevent timeoffset="0" message="Easy spin 95rpm"/></SteadyState>
    <SteadyState Duration="300" Power="0.800" Cadence="60"><textevent timeoffset="0" message="Force rep 3/5: 80% FTP @ 55-60rpm. Seated, quiet upper body"/><textevent timeoffset="150" message="Drive through the whole stroke"/></SteadyState>
    <SteadyState Duration="180" Power="0.600" Cadence="95"><textevent timeoffset="0" message="Easy spin 95rpm"/></SteadyState>
    <SteadyState Duration="300" Power="0.800" Cadence="60"><textevent timeoffset="0" message="Force rep 4/5: 80% FTP @ 55-60rpm. Seated, quiet upper body"/><textevent timeoffset="150" message="Drive through the whole stroke"/></SteadyState>
    <SteadyState Duration="180" Power="0.600" Cadence="95"><textevent timeoffset="0" message="Easy spin 95rpm"/></SteadyState>
    <SteadyState Duration="300" Power="0.800" Cadence="60"><textevent timeoffset="0" message="Force rep 5/5: 80% FTP @ 55-60rpm. Seated, quiet upper body"/><textevent timeoffset="150" message="Drive through the whole stroke"/></SteadyState>
    <SteadyState Duration="180" Power="0.600" Cadence="95"><textevent timeoffset="0" message="Easy spin 95rpm"/></SteadyState>
    <SteadyState Duration="300" Power="0.650"></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.42"><textevent timeoffset="0" message="Cool down. Nice work - spin it out"/></Cooldown>
  </workout>
</workout_file>
