<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>intervals-icu-planner-mcp example</author>
  <name>Threshold 3x8min</name>
  <description>Winter threshold: 3 x 8min @ 95% FTP, 4min recoveries. Should feel 7-8/10. If rep 1 feels harder than 8/10, lower your FTP setting by ~3%.</description>
  <sportType>bike</sportType>
  <tags><tag name="Threshold"/></tags>
  <workout>
    <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.68"><textevent timeoffset="0" message="Easy ramp-up. Settle in, 85-90rpm"/><textevent timeoffset="660" message="Almost done with warmup"/></Warmup>
    <SteadyState Duration="60" Power="0.600"></SteadyState>
    <SteadyState Duration="60" Power="0.850"><textevent timeoffset="0" message="Primer: 1min @ 85% FTP"/></SteadyState>
    <SteadyState Duration="60" Power="0.600"></SteadyState>
    <SteadyState Duration="30" Power="1.000"><textevent timeoffset="0" message="Primer: 30s @ 100% FTP"/></SteadyState>
    <SteadyState Duration="150" Power="0.550"><textevent timeoffset="0" message="Easy before main set"/></SteadyState>
    <SteadyState Duration="480" Power="0.950"><textevent timeoffset="0" message="Threshold 1/3: 8min @ 95% FTP"/><textevent timeoffset="240" message="Halfway. Even pressure, no surging"/></SteadyState>
    <SteadyState Duration="240" Power="0.550"><textevent timeoffset="0" message="Recover 4min - easy spin"/></SteadyState>
    <SteadyState Duration="480" Power="0.950"><textevent timeoffset="0" message="Threshold 2/3: 8min @ 95% FTP"/><textevent timeoffset="240" message="Halfway. Even pressure, no surging"/></SteadyState>
    <SteadyState Duration="240" Power="0.550"><textevent timeoffset="0" message="Recover 4min - easy spin"/></SteadyState>
    <SteadyState Duration="480" Power="0.950"><textevent timeoffset="0" message="Threshold 3/3: 8min @ 95% FTP"/><textevent timeoffset="240" message="Halfway. Even pressure, no surging"/></SteadyState>
    <SteadyState Duration="240" Power="0.550"><textevent timeoffset="0" message="Recover 4min - easy spin"/></SteadyState>
    <SteadyState Duration="600" Power="0.650"><textevent timeoffset="0" message="Flush with easy Z2"/></SteadyState>
    <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.42"><textevent timeoffset="0" message="Cool down. Nice work - spin it out"/></Cooldown>
  </workout>
</workout_file>
