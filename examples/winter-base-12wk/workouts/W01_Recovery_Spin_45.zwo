<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>zwo-plan-pusher example</author>
  <name>Recovery Spin 45min</name>
  <description>Active recovery. Stay under 55% FTP, heart rate in Zone 1. High cadence, zero strain.</description>
  <sportType>bike</sportType>
  <tags><tag name="Recovery"/></tags>
  <workout>
    <SteadyState Duration="300" Power="0.450"><textevent timeoffset="0" message="Recovery spin. Easy is the point."/></SteadyState>
    <SteadyState Duration="1800" Power="0.500"><textevent timeoffset="0" message="Hold ~50% FTP at 90-95rpm"/><textevent timeoffset="900" message="Halfway. Keep it light"/></SteadyState>
    <SteadyState Duration="600" Power="0.450"><textevent timeoffset="0" message="Last 10min, even easier"/></SteadyState>
  </workout>
</workout_file>
