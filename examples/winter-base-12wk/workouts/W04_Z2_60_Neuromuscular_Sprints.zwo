<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>intervals-icu-planner-mcp example</author>
  <name>Z2 60min + 6x10s Sprints</name>
  <description>Low-fatigue sprint maintenance (short sprints cost little fatigue). Turn ERG OFF for the sprints or use resistance/slope mode - ERG target is a placeholder.</description>
  <sportType>bike</sportType>
  <tags><tag name="Endurance"/><tag name="Sprint"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.68"><textevent timeoffset="0" message="Easy ramp-up. Settle in, 85-90rpm"/><textevent timeoffset="540" message="Almost done with warmup"/></Warmup>
    <SteadyState Duration="600" Power="0.680"><textevent timeoffset="0" message="Z2 @ 68% FTP"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 1/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 2/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 3/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 4/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 5/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="10" Power="1.500"><textevent timeoffset="0" message="SPRINT 6/6: 10s ALL-OUT. Seated 3s, then stand. Target 240% FTP+"/></SteadyState>
    <SteadyState Duration="230" Power="0.550"><textevent timeoffset="0" message="Full recovery - spin easy"/></SteadyState>
    <SteadyState Duration="660" Power="0.680"><textevent timeoffset="0" message="Back to Z2 @ 68% FTP"/></SteadyState>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.42"><textevent timeoffset="0" message="Cool down. Nice work - spin it out"/></Cooldown>
  </workout>
</workout_file>
